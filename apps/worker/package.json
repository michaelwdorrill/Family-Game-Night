{
  "name": "@family-game-night/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --env=\"\" --dry-run --outdir dist",
    "db:migrate:local": "wrangler d1 migrations apply family-game-night --local --env=\"\"",
    "db:migrate:staging": "wrangler d1 migrations apply family-game-night-staging --remote --env staging",
    "db:migrate:remote": "wrangler d1 migrations apply family-game-night --remote --env production",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy": "wrangler deploy --env production",
    "dev": "wrangler dev --env=\"\" --port 8787",
    "lint": "eslint src test",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@family-game-night/sequence-engine": "workspace:*",
    "@family-game-night/shared": "workspace:*",
    "hono": "4.13.21",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261119.1",
    "miniflare": "5.20261119.0-beta",
    "wrangler": "4.166.0"
  }
}
